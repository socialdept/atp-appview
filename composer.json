{
    "name": "socialdept/atp-appview",
    "description": "Build lexicon-driven AT Protocol AppViews in Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "atproto",
        "appview",
        "xrpc",
        "laravel"
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "socialdept/atp-client": "^0.3.8",
        "socialdept/atp-support": "^0.3.2"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "friendsofphp/php-cs-fixer": "^3.89"
    },
    "autoload": {
        "psr-4": {
            "SocialDept\\AtpAppview\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SocialDept\\AtpAppview\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SocialDept\\AtpAppview\\AtpAppviewServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
